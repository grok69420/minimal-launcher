<resources>

    <!-- Dark, edge-to-edge launcher theme. Prevents the white flash on launch. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowBackground">@color/launcher_bg</item>
        <item name="android:statusBarColor">@color/launcher_bg</item>
        <item name="android:navigationBarColor">@color/launcher_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

</resources>
